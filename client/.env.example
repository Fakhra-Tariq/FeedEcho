# =============================================================================
# FeedEcho — Frontend environment variables (client/)
# Copy to client/.env for local dev.
# On Render Static Site: set as Environment Variables before build (REACT_APP_*).
# These are baked into the build at compile time.
# =============================================================================

# Backend API base URL (include /api suffix)
# Local:
REACT_APP_API_URL=http://localhost:5000/api
# Render production example:
# REACT_APP_API_URL=https://feedecho-api.onrender.com/api

# Firebase Web SDK (public client config — safe to expose in frontend)
REACT_APP_FIREBASE_API_KEY=your-firebase-web-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: use Firebase-only auth flow (default false if unset)
# REACT_APP_FIREBASE_ONLY=false
