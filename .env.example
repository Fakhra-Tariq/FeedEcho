# =============================================================================
# FeedEcho — Backend environment variables (server/)
# Copy to .env for local dev. On Render: set these on the Web Service.
# Never commit real values. Do NOT upload serviceAccountKey.json to Render;
# use the FIREBASE_* variables below instead.
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=production
CLIENT_URL=https://feedecho-web.onrender.com

# --- Firebase Admin SDK (Realtime Database + Auth verification) ---
# Option A (recommended for Render): individual env vars from your service account JSON
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_LINES_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Option B (local dev only): path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./server/serviceAccountKey.json

# --- Google Gemini (AI quiz generation + study assistant) ---
GEMINI_API_KEY=your-gemini-api-key
# Study assistant uses a separate model (free tier: 20 req/day per model on gemini-2.5-flash)
STUDY_ASSISTANT_GEMINI_MODEL=gemini-2.5-flash-lite
